# Dashboard host/port (use the port your hosting panel gives you)
HOST=0.0.0.0
PORT=8080

# JWT signing key. Auto-generated into .env on first run if you leave it unset,
# but on a host with a non-persistent disk set it here so logins survive restarts.
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=d4521fa5e9ad537c0d8793f08347730588154692a8587b073ca5d2f9d189f677
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=72

# ---- Accounts (from Campalyze login system) ----
# Seeded ONCE when the database is first created; passwords are stored hashed.
# Use 12+ characters. More members can be added later from the Users button.
ADMIN_USERNAME=axiel
ADMIN_PASSWORD=replace_with_a_unique_password_at_least_16_chars
USER_2_USERNAME=anuvob
USER_2_PASSWORD=replace_with_a_unique_password_at_least_16_chars
USER_3_USERNAME=courtesy
USER_3_PASSWORD=replace_with_a_unique_password_at_least_16_chars

# SQLite file holding the accounts. Point at persistent storage on your host,
# or at your existing campalyze.db to keep your current users/passwords.
# DATABASE_PATH=/home/container/data/campalyze.db

TOKENS_FILE=tokens.txt

# Every member manages their OWN tokens from the dashboard (private to them).
# Admins use TOKENS_FILE above. Member token files are stored in MEMBER_TOKENS_DIR
# (default: a "user_tokens" folder next to the accounts database).
# MEMBER_MAX_TOKENS=25      # per-member limit, 0 = unlimited
# MEMBER_TOKENS_DIR=/home/container/data/user_tokens

# Cloudflare quick-tunnel (set false on a host that already gives you a domain)
ENABLE_TUNNEL=true
CLOUDFLARED_PATH=/usr/local/bin/cloudflared
